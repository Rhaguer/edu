# ==============================================================================
# EduAndes AI (Netlify Edition) — Variables de Entorno
# Configura estas variables en:
#   Netlify Dashboard -> Site configuration -> Environment variables
# o en un archivo `.env` local para `npm run dev` / `npm run dev:local`.
# ==============================================================================

# Motor IA: "openai_compat" (Groq / Gemini / OpenAI) o "bedrock" (AWS Bedrock)
EDUCORE_ENGINE=openai_compat

# --- Opción 1: Groq Cloud API (recomendado, gratuito y ultrarrápido) ---
EDUCORE_LLM_BASE_URL=https://api.groq.com/openai/v1
EDUCORE_LLM_API_KEY=gsk_reemplaza_con_tu_api_key
EDUCORE_LLM_MODEL=llama-3.3-70b-versatile

# --- Opción 2: Amazon Bedrock (opcional, SigV4 puro sin boto3/AWS SDK) ---
# EDUCORE_ENGINE=bedrock
# EDUCORE_AWS_REGION=us-east-1
# EDUCORE_BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
# AWS_SESSION_TOKEN=...

# --- Contraseñas iniciales (solo si la base se inicializa por primera vez) ---
# Por defecto las 4 cuentas demo inician con "123456" (igual que EDUANDES_IA).
# En producción cámbialas desde el Panel Admin o define estas variables:
# EDUCORE_SEED_ADMIN_PASSWORD=123456
# EDUCORE_SEED_TEACHER_PASSWORD=123456
# EDUCORE_SEED_STUDENT_PASSWORD=123456
# EDUCORE_SEED_WELLNESS_PASSWORD=123456
